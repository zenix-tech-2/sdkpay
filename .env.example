# Local database (or Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Ashtechpay Direct API — primary for Mobile Money and exclusive for crypto
ASHTECHPAY_BASE_URL=https://www.ashtechpay.com
ASHTECHPAY_DIRECT_KEY=
ASHTECHPAY_COLLECT_PATH=/v1/collect
ASHTECHPAY_CRYPTO_COLLECT_PATH=/v1/crypto/collect
ASHTECHPAY_CRYPTO_PAYOUT_PATH=/v1/crypto/payout
ASHTECHPAY_PAYOUT_PATH=/v1/payout
ASHTECHPAY_WEBHOOK_SECRET=
ASHTECHPAY_ENV=sandbox

# Optional allowlists. If omitted, built-in demo catalog is used.
ASHTECHPAY_SUPPORTED_COUNTRIES=CM,CI,SN,BJ,TG,GH,NG,KE
ASHTECHPAY_SUPPORTED_OPERATORS=MTN Money,Orange Money,Wave,Moov Money,Airtel Money,Free Money,M-Pesa,Celtiis Money,Coris Money
ASHTECHPAY_SKIP_CATALOG=0

# Saaspay.me Direct API — fallback when Ashtechpay lacks a country/operator
SAASPAY_BASE_URL=https://api.saspay.me/api/v1
SAASPAY_API_KEY=
SAASPAY_COLLECT_PATH=/payments/softpay/
SAASPAY_PAYOUT_PATH=/payments/transfer/
SAASPAY_WEBHOOK_SECRET=
# Optional JSON map, e.g. {"CM:MTN Money":"mtn_cm","BJ:Celtiis Money":"celtiis_bj"}
SAASPAY_NETWORK_MAP=

# Independent admin deployment
# Set ADMIN_ONLY_DEPLOYMENT=1 on the admin Vercel project to hide client routes.
ADMIN_ONLY_DEPLOYMENT=0
ADMIN_DATABASE_URL=
ADMIN_EMAIL=admin@sdkpay.com
ADMIN_PASSWORD=admin1234
ADMIN_FULL_NAME=SDK Pay Admin
ADMIN_SESSION_TTL_DAYS=7
NEXT_PUBLIC_CLIENT_APP_URL=https://client.example.com

