# ---- Database (Supabase / PostgreSQL) ----
# Pooler connection string (Subasisport 6543) — safe for serverless
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- AshTech Pay — PRIMARY provider (Direct API, no hosted checkout) ----
# Base URL defaults to https://www.ashtechpay.com/v1
ASHTECH_BASE_URL=https://www.ashtechpay.com/v1
# Direct API key (ak_...) — server-side only, never in the browser
ASHTECH_API_KEY=ak_live_...
# AshTech Pay merchant profile id bound to the key
ASHTECH_USER_ID=
# Webhook signing secret (whsec_...) — dashboard → Clé API → Direct API → Secret webhook
ASHTECH_WEBHOOK_SECRET=whsec_...

# ---- SasPay — BACKUP provider (used when AshTech can't serve an operator/country) ----
# Base URL defaults to https://api.saspay.me/api/v1
SASPAY_BASE_URL=https://api.saspay.me/api/v1
# Secret API key (sk_test_... in test, sk_live_... in production) — server-side only
SASPAY_API_KEY=sk_live_...
# Webhook signing secret (if your SasPay dashboard issues one)
SASPAY_WEBHOOK_SECRET=

# ---- App ----
# Public origin of this app — used to build notify_url for provider webhooks
APP_URL=https://your-domain.com

# ---- Deployment split ----
# merchant (default) → customer app only, /admin returns 404
# admin              → admin console only, all other routes redirect to /admin
APP_ROLE=merchant
